    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "immer": "^10.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "next-auth": "^5.0.0-beta.30",
    "papaparse": "^5.5.3",
    "pg": "^8.16.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
