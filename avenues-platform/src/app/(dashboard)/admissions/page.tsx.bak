'use client';

import React, { useState } from 'react';
import { Download, TrendingUp, TrendingDown } from 'lucide-react';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { StatCard } from '@/components/charts/stat-card';
import { ChartCard } from '@/components/dashboard/chart-card';
import { LineChartComponent } from '@/components/charts/line-chart';
import { AreaChartComponent } from '@/components/charts/area-chart';
import { BarChartComponent } from '@/components/charts/bar-chart';
import { PieChartComponent } from '@/components/charts/pie-chart';
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/ui/table';

// Sample data - all hardcoded for demo
const MONTHS = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December'
];

const monthlyData = [
  { month: 'Jan', casualty: 145, dayCase: 89, inpatient: 234, total: 468 },
  { month: 'Feb', casualty: 152, dayCase: 95, inpatient: 241, total: 488 },
  { month: 'Mar', casualty: 168, dayCase: 102, inpatient: 256, total: 526 },
  { month: 'Apr', casualty: 172, dayCase: 110, inpatient: 268, total: 550 },
  { month: 'May', casualty: 189, dayCase: 125, inpatient: 285, total: 599 },
  { month: 'Jun', casualty: 198, dayCase: 132, inpatient: 302, total: 632 },
  { month: 'Jul', casualty: 205, dayCase: 140, inpatient: 315, total: 660 },
  { month: 'Aug', casualty: 198, dayCase: 135, inpatient: 308, total: 641 },
  { month: 'Sep', casualty: 185, dayCase: 128, inpatient: 295, total: 608 },
  { month: 'Oct', casualty: 175, dayCase: 115, inpatient: 280, total: 570 },
  { month: 'Nov', casualty: 162, dayCase: 105, inpatient: 265, total: 532 },
  { month: 'Dec', casualty: 178, dayCase: 118, inpatient: 278, total: 574 },
];

const admissionBySpecialty = [
  { specialty: 'Cardiology', count: 458 },
  { specialty: 'Orthopedics', count: 512 },
  { specialty: 'Neurology', count: 385 },
  { specialty: 'General Surgery', count: 628 },
  { specialty: 'Urology', count: 312 },
  { specialty: 'ENT', count: 278 },
  { specialty: 'Pediatrics', count: 395 },
  { specialty: 'Gynecology', count: 445 },
];

const admissionByMedAid = [
  { aid: 'SAMHSA', count: 1245 },
  { aid: 'CompCare', count: 1082 },
  { aid: 'Momentum', count: 876 },
  { aid: 'Discovery', count: 1456 },
  { aid: 'Intercare', count: 934 },
  { aid: 'Cash Paying', count: 2134 },
];

const dayOfWeekData = [
  { day: 'Monday', admissions: 892 },
  { day: 'Tuesday', admissions: 1045 },
  { day: 'Wednesday', admissions: 1123 },
  { day: 'Thursday', admissions: 1089 },
  { day: 'Friday', admissions: 1234 },
  { day: 'Saturday', admissions: 756 },
  { day: 'Sunday', admissions: 634 },
];

const forecastData = [
  { month: 'Jan', actual: 468, forecast: 460, upper: 520, lower: 400 },
  { month: 'Feb', actual: 488, forecast: 495, upper: 555, lower: 435 },
  { month: 'Mar', actual: 526, forecast: 535, upper: 595, lower: 475 },
  { month: 'Apr', actual: 550, forecast: 560, upper: 620, lower: 500 },
  { month: 'May', actual: 599, forecast: 595, upper: 655, lower: 535 },
  { month: 'Jun', actual: 632, forecast: 640, upper: 700, lower: 580 },
  { month: 'Jul', actual: 660, forecast: 665, upper: 725, lower: 605 },
  { month: 'Aug', actual: 641, forecast: 650, upper: 710, lower: 590 },
  { month: 'Sep', actual: 608, forecast: 615, upper: 675, lower: 555 },
  { month: 'Oct', actual: 570, forecast: 575, upper: 635, lower: 515 },
  { month: 'Nov', actual: 532, forecast: 540, upper: 600, lower: 480 },
  { month: 'Dec', actual: 574, forecast: 580, upper: 640, lower: 520 },
];

const yoyData = [
  { month: 'Jan', year2024: 468, year2025: 512, year2026: 574 },
  { month: 'Feb', year2024: 488, year2025: 525, year2026: 618 },
  { month: 'Mar', year2024: 526, year2025: 562, year2026: 645 },
  { month: 'Apr', year2024: 550, year2025: 585, year2026: 672 },
  { month: 'May', year2024: 599, year2025: 628, year2026: 715 },
  { month: 'Jun', year2024: 632, year2025: 665, year2026: 758 },
  { month: 'Jul', year2024: 660, year2025: 695, year2026: 782 },
  { month: 'Aug', year2024: 641, year2025: 675, year2026: 764 },
  { month: 'Sep', year2024: 608, year2025: 642, year2026: 728 },
  { month: 'Oct', year2024: 570, year2025: 605, year2026: 685 },
  { month: 'Nov', year2024: 532, year2025: 565, year2026: 642 },
  { month: 'Dec', year2024: 574, year2025: 605, year2026: 688 },
];

export default function AdmissionsPage() {
  const [selectedYear, setSelectedYear] = useState('2026');

  const totalAdmissions = monthlyData.reduce((sum, m) => sum + m.total, 0);
  const totalCasualty = monthlyData.reduce((sum, m) => sum + m.casualty, 0);
  const totalDayCase = monthlyData.reduce((sum, m) => sum + m.dayCase, 0);
  const totalInpatient = monthlyData.reduce((sum, m) => sum + m.inpatient, 0);
  const avgMonthly = Math.round(totalAdmissions / 12);

  // Calculate CAGR (2024-2026)
  const cagr = ((Math.pow(574 / 468, 1/2) - 1) * 100).toFixed(1);

  const handleExport = () => {
    const csvContent = [
      ['Month', 'Casualty', 'Day Case', 'Inpatient', 'Total'],
      ...monthlyData.map(m => [m.month, m.casualty, m.dayCase, m.inpatient, m.total])
    ];
    const csv = csvContent.map(row => row.join(',')).join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'admissions-data.csv';
    a.click();
  };

  return (
    <div className="space-y-6">
      {/* Page Header */}
      <div>
        <h1 className="text-3xl font-bold text-slate-900">Admissions Analytics</h1>
        <p className="mt-2 text-slate-600">
          Comprehensive admission trends, patterns, and forecasting
        </p>
      </div>

      {/* KPI Cards */}
      <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-5">
        <StatCard
          title="Total Admissions"
          value={totalAdmissions.toLocaleString()}
          change={22}
          trend="up"
          color="blue"
          icon={TrendingUp}
        />
        <StatCard
          title="Casualty"
          value={totalCasualty.toLocaleString()}
          change={18}
          trend="up"
          color="red"
        />
        <StatCard
          title="Day Case"
          value={totalDayCase.toLocaleString()}
          change={15}
          trend="up"
          color="amber"
        />
        <StatCard
          title="Inpatient"
          value={totalInpatient.toLocaleString()}
          change={25}
          trend="up"
          color="green"
        />
        <StatCard
          title="Avg Monthly"
          value={avgMonthly.toLocaleString()}
          subtitle={`CAGR: ${cagr}%`}
          color="purple"
        />
      </div>

      {/* Main Charts */}
      <ChartCard
        title="Monthly Admissions Trend"
        subtitle="12-month trend showing overall admission volumes"
        onExport={handleExport}
      >
        <LineChartComponent
          data={monthlyData}
          xKey="month"
          lines={[
            { key: 'total', color: '#0d1f3c', name: 'Total Admissions' }
          ]}
          height={300}
        />
      </ChartCard>

      <ChartCard
        title="Admission Type Breakdown"
        subtitle="Stacked view: Casualty, Day Case, and Inpatient admissions per month"
      >
        <BarChartComponent
          data={monthlyData}
          xKey="month"
          bars={[
            { key: 'casualty', color: '#e11d48', name: 'Casualty' },
            { key: 'dayCase', color: '#f59e0b', name: 'Day Case' },
            { key: 'inpatient', color: '#10b981', name: 'Inpatient' },
          ]}
          height={300}
          showLegend={true}
        />
      </ChartCard>

      {/* YoY Comparison */}
      {selectedYear === '2026' && (
        <ChartCard
          title="Year-over-Year Comparison"
          subtitle="Comparison across 2024, 2025, and 2026"
        >
          <LineChartComponent
            data={yoyData}
            xKey="month"
            lines={[
              { key: 'year2024', color: '#94a3b8', name: '2024' },
              { key: 'year2025', color: '#3b82f6', name: '2025' },
              { key: 'year2026', color: '#00b8a0', name: '2026' },
            ]}
            height={300}
          />
        </ChartCard>
      )}

      {/* Two-column layout */}
      <div className="grid gap-6 lg:grid-cols-2">
        {/* Admissions by Specialty */}
        <ChartCard
          title="Admissions by Specialty"
          subtitle="Ranked by admission volume"
        >
          <BarChartComponent
            data={admissionBySpecialty.sort((a, b) => b.count - a.count)}
            xKey="specialty"
            bars={[
              { key: 'count', color: '#7c3aed', name: 'Admissions' },
            ]}
            height={320}
            layout="horizontal"
            showLegend={false}
          />
        </ChartCard>

        {/* Admissions by Medical Aid */}
        <ChartCard
          title="Admissions by Medical Aid"
          subtitle="Distribution across insurance schemes"
        >
          <BarChartComponent
            data={admissionByMedAid.sort((a, b) => b.count - a.count)}
            xKey="aid"
            bars={[
              { key: 'count', color: '#06b6d4', name: 'Admissions' },
            ]}
            height={320}
            layout="horizontal"
            showLegend={false}
          />
        </ChartCard>
      </div>

      {/* Day of Week Distribution */}
      <ChartCard
        title="Day of Week Distribution"
        subtitle="Admission patterns across weekdays"
      >
        <BarChartComponent
          data={dayOfWeekData}
          xKey="day"
          bars={[
            { key: 'admissions', color: '#f59e0b', name: 'Admissions' },
          ]}
          height={280}
          showLegend={false}
        />
      </ChartCard>

      {/* Forecast Chart */}
      <ChartCard
        title="12-Month Admission Forecast"
        subtitle="Predicted admissions with confidence intervals"
      >
        <AreaChartComponent
          data={forecastData}
          xKey="month"
          yKeys={[
            { key: 'upper', color: '#c7d2e0', name: 'Upper Bound' },
            { key: 'forecast', color: '#00b8a0', name: 'Forecast' },
            { key: 'lower', color: '#e5e7eb', name: 'Lower Bound' },
          ]}
          height={300}
        />
      </ChartCard>

      {/* CAGR and Metrics Table */}
      <Card>
        <CardHeader>
          <CardTitle>Key Metrics Summary</CardTitle>
          <CardDescription>Annual admissions performance indicators</CardDescription>
        </CardHeader>
        <CardContent>
          <div className="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
            <div className="space-y-2">
              <p className="text-sm font-medium text-slate-600">CAGR (2024-2026)</p>
              <p className="text-2xl font-bold text-green-600">{cagr}%</p>
            </div>
            <div className="space-y-2">
              <p className="text-sm font-medium text-slate-600">Casualty Rate</p>
              <p className="text-2xl font-bold">
                {((totalCasualty / totalAdmissions) * 100).toFixed(1)}%
              </p>
            </div>
            <div className="space-y-2">
              <p className="text-sm font-medium text-slate-600">Day Case Rate</p>
              <p className="text-2xl font-bold">
                {((totalDayCase / totalAdmissions) * 100).toFixed(1)}%
              </p>
            </div>
            <div className="space-y-2">
              <p className="text-sm font-medium text-slate-600">Inpatient Rate</p>
              <p className="text-2xl font-bold">
                {((totalInpatient / totalAdmissions) * 100).toFixed(1)}%
              </p>
            </div>
          </div>
        </CardContent>
      </Card>
    </div>
  );
}
