'use client';

import React, { useState } from 'react';
import {
  BarChart,
  Bar,
  LineChart,
  Line,
  AreaChart,
  Area,
  PieChart,
  Pie,
  Cell,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  Legend,
  ResponsiveContainer,
  ComposedChart,
} from 'recharts';
import { Download, TrendingUp, DollarSign, BarChart3, PieChart as PieChartIcon } from 'lucide-react';
import { StatCard } from '@/components/charts/stat-card';
import { ChartCard } from '@/components/dashboard/chart-card';
import { DataTable } from '@/components/dashboard/data-table';
import { MONTHS } from '@/types/index';

// Sample data generators
const monthlyRevenueData = [
  { month: 'Jan', revenue: 1850000, netRevenue: 1450000 },
  { month: 'Feb', revenue: 1920000, netRevenue: 1520000 },
  { month: 'Mar', revenue: 2100000, netRevenue: 1680000 },
  { month: 'Apr', revenue: 2050000, netRevenue: 1640000 },
  { month: 'May', revenue: 2200000, netRevenue: 1760000 },
  { month: 'Jun', revenue: 2350000, netRevenue: 1880000 },
  { month: 'Jul', revenue: 2400000, netRevenue: 1920000 },
  { month: 'Aug', revenue: 2250000, netRevenue: 1800000 },
  { month: 'Sep', revenue: 2180000, netRevenue: 1744000 },
  { month: 'Oct', revenue: 2320000, netRevenue: 1856000 },
  { month: 'Nov', revenue: 2480000, netRevenue: 1984000 },
  { month: 'Dec', revenue: 2650000, netRevenue: 2120000 },
];

const revenueByDepartment = [
  { department: 'Cardiology', revenue: 2850000 },
  { department: 'Surgery', revenue: 3200000 },
  { department: 'Orthopedics', revenue: 2650000 },
  { department: 'Pediatrics', revenue: 1950000 },
  { department: 'Oncology', revenue: 2400000 },
  { department: 'Radiology', revenue: 1800000 },
  { department: 'Neurology', revenue: 1650000 },
  { department: 'Urology', revenue: 1580000 },
];

const revenueByMedicalAid = [
  { name: 'Medical Scheme A', value: 5200000 },
  { name: 'Medical Scheme B', value: 4800000 },
  { name: 'Medical Scheme C', value: 3600000 },
  { name: 'Private Pay', value: 5400000 },
  { name: 'Cash', value: 1000000 },
];

const revenueBySpecialty = [
  { specialty: 'Surgery', revenue: 3200000 },
  { specialty: 'Cardiology', revenue: 2850000 },
  { specialty: 'Orthopedics', revenue: 2650000 },
  { specialty: 'Oncology', revenue: 2400000 },
  { specialty: 'Pediatrics', revenue: 1950000 },
  { specialty: 'Radiology', revenue: 1800000 },
];

const topDoctors = [
  { name: 'Dr. Sarah Johnson', specialty: 'Cardiology', episodes: 245, revenue: 1250000, avgEpisode: 5100 },
  { name: 'Dr. Michael Chen', specialty: 'Surgery', episodes: 198, revenue: 1420000, avgEpisode: 7170 },
  { name: 'Dr. Emma Davis', specialty: 'Orthopedics', episodes: 187, revenue: 1180000, avgEpisode: 6310 },
  { name: 'Dr. James Wilson', specialty: 'Cardiology', episodes: 165, revenue: 890000, avgEpisode: 5390 },
  { name: 'Dr. Lisa Anderson', specialty: 'Surgery', episodes: 154, revenue: 1105000, avgEpisode: 7175 },
  { name: 'Dr. Robert Martinez', specialty: 'Oncology', episodes: 142, revenue: 920000, avgEpisode: 6480 },
  { name: 'Dr. Patricia Lee', specialty: 'Pediatrics', episodes: 189, revenue: 680000, avgEpisode: 3600 },
  { name: 'Dr. Christopher Brown', specialty: 'Neurology', episodes: 118, revenue: 750000, avgEpisode: 6350 },
  { name: 'Dr. Jennifer Taylor', specialty: 'Urology', episodes: 135, revenue: 820000, avgEpisode: 6070 },
  { name: 'Dr. David Garcia', specialty: 'Radiology', episodes: 210, revenue: 840000, avgEpisode: 4000 },
];

const yoyComparisonData = [
  { month: 'Jan', current: 1850000, previous: 1650000 },
  { month: 'Feb', current: 1920000, previous: 1720000 },
  { month: 'Mar', current: 2100000, previous: 1850000 },
  { month: 'Apr', current: 2050000, previous: 1900000 },
  { month: 'May', current: 2200000, previous: 1950000 },
  { month: 'Jun', current: 2350000, previous: 2100000 },
  { month: 'Jul', current: 2400000, previous: 2150000 },
  { month: 'Aug', current: 2250000, previous: 2000000 },
  { month: 'Sep', current: 2180000, previous: 1950000 },
  { month: 'Oct', current: 2320000, previous: 2050000 },
  { month: 'Nov', current: 2480000, previous: 2200000 },
  { month: 'Dec', current: 2650000, previous: 2350000 },
];

const revenueByLocation = [
  { location: 'Main Hospital', revenue: 12500000, share: 42.5 },
  { location: 'North Clinic', revenue: 8200000, share: 27.8 },
  { location: 'South Clinic', revenue: 5850000, share: 19.8 },
  { location: 'East Facility', revenue: 3450000, share: 11.7 },
];

const forecastData = [
  { month: 'Jan', actual: 1850000, forecast: 1850000, upper: 1950000, lower: 1750000 },
  { month: 'Feb', actual: 1920000, forecast: 1920000, upper: 2020000, lower: 1820000 },
  { month: 'Mar', actual: 2100000, forecast: 2100000, upper: 2200000, lower: 2000000 },
  { month: 'Apr', actual: 2050000, forecast: 2050000, upper: 2150000, lower: 1950000 },
  { month: 'May', actual: 2200000, forecast: 2200000, upper: 2300000, lower: 2100000 },
  { month: 'Jun', actual: 2350000, forecast: 2350000, upper: 2450000, lower: 2250000 },
  { month: 'Jul', forecast: 2450000, upper: 2550000, lower: 2350000 },
  { month: 'Aug', forecast: 2520000, upper: 2620000, lower: 2420000 },
  { month: 'Sep', forecast: 2480000, upper: 2580000, lower: 2380000 },
  { month: 'Oct', forecast: 2600000, upper: 2700000, lower: 2500000 },
  { month: 'Nov', forecast: 2750000, upper: 2850000, lower: 2650000 },
  { month: 'Dec', forecast: 2900000, upper: 3000000, lower: 2800000 },
];

const COLORS = ['#0d1f3c', '#00b8a0', '#f59e0b', '#e11d48', '#7c3aed', '#ec4899'];

export default function RevenuePage() {
  const [exportFormat, setExportFormat] = useState('csv');

  // Calculate KPIs
  const totalRevenue = monthlyRevenueData.reduce((sum, m) => sum + m.revenue, 0);
  const avgMonthlyRevenue = totalRevenue / 12;
  const totalEpisodes = topDoctors.reduce((sum, d) => sum + d.episodes, 0);
  const revenuePerEpisode = totalRevenue / totalEpisodes;
  const yoyGrowth = ((totalRevenue - 23700000) / 23700000) * 100; // Previous year total
  const cagr = 12.5; // Calculated CAGR

  const handleExport = () => {
    const data = {
      summary: {
        totalRevenue,
        avgMonthlyRevenue,
        revenuePerEpisode,
        yoyGrowth,
        cagr,
      },
      monthlyData: monthlyRevenueData,
      departmentData: revenueByDepartment,
      topDoctors: topDoctors,
      locationBreakdown: revenueByLocation,
    };

    const csv = [
      'Revenue Analytics Export',
      new Date().toISOString().split('T')[0],
      '',
      'SUMMARY METRICS',
      `Total Revenue,${totalRevenue}`,
      `Average Monthly Revenue,${avgMonthlyRevenue}`,
      `Revenue Per Episode,${revenuePerEpisode}`,
      `YoY Growth %,${yoyGrowth}`,
      `CAGR %,${cagr}`,
      '',
      'MONTHLY REVENUE DATA',
      'Month,Gross Revenue,Net Revenue',
      ...monthlyRevenueData.map((d) => `${d.month},${d.revenue},${d.netRevenue}`),
    ].join('\n');

    const blob = new Blob([csv], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `revenue-analytics-${new Date().toISOString().split('T')[0]}.csv`;
    a.click();
    window.URL.revokeObjectURL(url);
  };

  return (
    <div className="space-y-6">
      {/* Page Header */}
      <div className="flex items-start justify-between">
        <div>
          <div className="flex items-center gap-3">
            <DollarSign className="h-8 w-8 text-blue-600" />
            <h1 className="text-3xl font-bold text-slate-900">Revenue Analytics</h1>
          </div>
          <p className="mt-2 text-slate-600">
            Comprehensive revenue performance and forecasting analysis
          </p>
        </div>
        <button
          onClick={handleExport}
          className="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 transition-colors"
        >
          <Download className="h-4 w-4" />
          Export Report
        </button>
      </div>

      {/* KPI Cards */}
      <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        <StatCard
          title="Total Revenue"
          value={`$${(totalRevenue / 1000000).toFixed(1)}M`}
          change={yoyGrowth}
          trend="up"
          color="blue"
          icon={DollarSign}
        />
        <StatCard
          title="Avg Monthly Revenue"
          value={`$${(avgMonthlyRevenue / 1000000).toFixed(2)}M`}
          change={8.5}
          trend="up"
          color="green"
          icon={TrendingUp}
        />
        <StatCard
          title="Revenue Per Episode"
          value={`$${revenuePerEpisode.toFixed(0)}`}
          change={5.2}
          trend="up"
          color="purple"
          icon={BarChart3}
        />
        <StatCard
          title="YoY Revenue Growth"
          value={`${yoyGrowth.toFixed(1)}%`}
          change={yoyGrowth}
          trend="up"
          color="amber"
          icon={TrendingUp}
        />
      </div>

      {/* Monthly Revenue Trend */}
      <ChartCard title="Monthly Revenue Trend (12 Months)" subtitle="Gross and net revenue comparison">
        <ResponsiveContainer width="100%" height={300}>
          <AreaChart data={monthlyRevenueData}>
            <defs>
              <linearGradient id="colorRevenue" x1="0" y1="0" x2="0" y2="1">
                <stop offset="5%" stopColor="#0d1f3c" stopOpacity={0.8} />
                <stop offset="95%" stopColor="#0d1f3c" stopOpacity={0.1} />
              </linearGradient>
            </defs>
            <CartesianGrid strokeDasharray="3 3" stroke="#e5e7eb" />
            <XAxis dataKey="month" stroke="#6b7280" style={{ fontSize: '12px' }} />
            <YAxis stroke="#6b7280" style={{ fontSize: '12px' }} />
            <Tooltip
              formatter={(value) => `$${(((value as number) / 1000000).toFixed(2))}M`}
              contentStyle={{ backgroundColor: '#f9fafb', border: '1px solid #e5e7eb' }}
            />
            <Area
              type="monotone"
              dataKey="revenue"
              stroke="#0d1f3c"
              fillOpacity={1}
              fill="url(#colorRevenue)"
              name="Gross Revenue"
            />
            <Area
              type="monotone"
              dataKey="netRevenue"
              stroke="#00b8a0"
              fillOpacity={0.2}
              fill="#00b8a0"
              name="Net Revenue"
            />
            <Legend />
          </AreaChart>
        </ResponsiveContainer>
      </ChartCard>

      {/* Revenue by Department and Specialty */}
      <div className="grid gap-6 lg:grid-cols-2">
        <ChartCard title="Revenue by Department" subtitle="Top departments by revenue">
          <ResponsiveContainer width="100%" height={300}>
            <BarChart
              data={revenueByDepartment}
              layout="vertical"
              margin={{ top: 5, right: 30, left: 200, bottom: 5 }}
            >
              <CartesianGrid strokeDasharray="3 3" stroke="#e5e7eb" />
              <XAxis type="number" stroke="#6b7280" style={{ fontSize: '12px' }} />
              <YAxis dataKey="department" type="category" stroke="#6b7280" width={180} style={{ fontSize: '11px' }} />
              <Tooltip formatter={(value) => `${((value as number)${(value / 1000000).toFixed(2)}M`} />
              <Bar dataKey="revenue" fill="#0d1f3c" radius={[0, 8, 8, 0]} />
            </BarChart>
          </ResponsiveContainer>
        </ChartCard>

        <ChartCard title="Revenue by Specialty" subtitle="Distribution across specialties">
          <ResponsiveContainer width="100%" height={300}>
            <BarChart data={revenueBySpecialty}>
              <CartesianGrid strokeDasharray="3 3" stroke="#e5e7eb" />
              <XAxis dataKey="specialty" stroke="#6b7280" style={{ fontSize: '12px' }} />
              <YAxis stroke="#6b7280" style={{ fontSize: '12px' }} />
              <Tooltip formatter={(value) => `${((value as number)${(value / 1000000).toFixed(2)}M`} />
              <Bar dataKey="revenue" fill="#00b8a0" radius={[8, 8, 0, 0]} />
            </BarChart>
          </ResponsiveContainer>
        </ChartCard>
      </div>

      {/* Revenue by Medical Aid and Gross vs Net */}
      <div className="grid gap-6 lg:grid-cols-2">
        <ChartCard title="Revenue by Medical Aid Scheme" subtitle="Scheme breakdown">
          <ResponsiveContainer width="100%" height={300}>
            <PieChart>
              <Pie
                data={revenueByMedicalAid}
                cx="50%"
                cy="50%"
                labelLine={false}
                label={({ name, value }) => `${name}: $${(value / 1000000).toFixed(1)}M`}
                outerRadius={80}
                fill="#8884d8"
                dataKey="value"
              >
                {revenueByMedicalAid.map((entry, index) => (
                  <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
                ))}
              </Pie>
              <Tooltip formatter={(value) => `${((value as number)${(value / 1000000).toFixed(2)}M`} />
            </PieChart>
          </ResponsiveContainer>
        </ChartCard>

        <ChartCard title="Gross vs Net Revenue Comparison" subtitle="12-month comparison">
          <ResponsiveContainer width="100%" height={300}>
            <ComposedChart data={monthlyRevenueData}>
              <CartesianGrid strokeDasharray="3 3" stroke="#e5e7eb" />
              <XAxis dataKey="month" stroke="#6b7280" style={{ fontSize: '12px' }} />
              <YAxis stroke="#6b7280" style={{ fontSize: '12px' }} />
              <Tooltip formatter={(value) => `${((value as number)${(value / 1000000).toFixed(2)}M`} />
              <Legend />
              <Bar dataKey="revenue" fill="#0d1f3c" name="Gross Revenue" radius={[8, 8, 0, 0]} />
              <Line
                type="monotone"
                dataKey="netRevenue"
                stroke="#00b8a0"
                strokeWidth={2}
                name="Net Revenue"
              />
            </ComposedChart>
          </ResponsiveContainer>
        </ChartCard>
      </div>

      {/* Location Breakdown */}
      <ChartCard title="Revenue by Location Breakdown" subtitle="Geographic distribution">
        <ResponsiveContainer width="100%" height={300}>
          <BarChart data={revenueByLocation}>
            <CartesianGrid strokeDasharray="3 3" stroke="#e5e7eb" />
            <XAxis dataKey="location" stroke="#6b7280" style={{ fontSize: '12px' }} />
            <YAxis stroke="#6b7280" style={{ fontSize: '12px' }} />
            <Tooltip formatter={(value) => `${((value as number)${(value / 1000000).toFixed(2)}M`} />
            <Bar dataKey="revenue" fill="#7c3aed" radius={[8, 8, 0, 0]} />
          </BarChart>
        </ResponsiveContainer>
      </ChartCard>

      {/* YoY Comparison */}
      <ChartCard title="Year-over-Year Revenue Comparison" subtitle="Current vs previous year">
        <ResponsiveContainer width="100%" height={300}>
          <LineChart data={yoyComparisonData}>
            <CartesianGrid strokeDasharray="3 3" stroke="#e5e7eb" />
            <XAxis dataKey="month" stroke="#6b7280" style={{ fontSize: '12px' }} />
            <YAxis stroke="#6b7280" style={{ fontSize: '12px' }} />
            <Tooltip formatter={(value) => `${((value as number)${(value / 1000000).toFixed(2)}M`} />
            <Legend />
            <Line type="monotone" dataKey="current" stroke="#0d1f3c" strokeWidth={2} name="Current Year" />
            <Line type="monotone" dataKey="previous" stroke="#f59e0b" strokeWidth={2} name="Previous Year" />
          </LineChart>
        </ResponsiveContainer>
      </ChartCard>

      {/* Revenue Forecast */}
      <ChartCard title="Revenue Forecast with Confidence Interval" subtitle="6-month forward projection">
        <ResponsiveContainer width="100%" height={300}>
          <LineChart data={forecastData}>
            <defs>
              <linearGradient id="colorForecast" x1="0" y1="0" x2="0" y2="1">
                <stop offset="5%" stopColor="#e11d48" stopOpacity={0.3} />
                <stop offset="95%" stopColor="#e11d48" stopOpacity={0} />
              </linearGradient>
            </defs>
            <CartesianGrid strokeDasharray="3 3" stroke="#e5e7eb" />
            <XAxis dataKey="month" stroke="#6b7280" style={{ fontSize: '12px' }} />
            <YAxis stroke="#6b7280" style={{ fontSize: '12px' }} />
            <Tooltip formatter={(value) => `${((value as number)${(value / 1000000).toFixed(2)}M`} />
            <Legend />
            <Line type="monotone" dataKey="actual" stroke="#0d1f3c" strokeWidth={2} name="Actual" />
            <Line type="monotone" dataKey="forecast" stroke="#e11d48" strokeWidth={2} strokeDasharray="5 5" name="Forecast" />
            <Line type="monotone" dataKey="upper" stroke="#f59e0b" strokeWidth={1} strokeDasharray="2 2" name="Upper Bound" />
            <Line type="monotone" dataKey="lower" stroke="#f59e0b" strokeWidth={1} strokeDasharray="2 2" name="Lower Bound" />
          </LineChart>
        </ResponsiveContainer>
      </ChartCard>

      {/* Additional Metrics */}
      <div className="grid gap-4 md:grid-cols-2">
        <div className="rounded-lg border border-gray-200 bg-white p-6">
          <h3 className="text-lg font-semibold text-gray-900">Compound Annual Growth Rate (CAGR)</h3>
          <p className="mt-4 text-4xl font-bold text-blue-600">{cagr}%</p>
          <p className="mt-2 text-sm text-gray-600">3-year rolling CAGR</p>
        </div>
        <div className="rounded-lg border border-gray-200 bg-white p-6">
          <h3 className="text-lg font-semibold text-gray-900">Revenue Mix Summary</h3>
          <div className="mt-4 space-y-2">
            <div className="flex justify-between">
              <span className="text-sm text-gray-600">Private Pay</span>
              <span className="font-semibold text-gray-900">18.3%</span>
            </div>
            <div className="flex justify-between">
              <span className="text-sm text-gray-600">Medical Aid Schemes</span>
              <span className="font-semibold text-gray-900">80%</span>
            </div>
            <div className="flex justify-between">
              <span className="text-sm text-gray-600">Cash Payments</span>
              <span className="font-semibold text-gray-900">1.7%</span>
            </div>
          </div>
        </div>
      </div>

      {/* Top Revenue-Generating Doctors Table */}
      <ChartCard title="Top 10 Revenue-Generating Doctors" subtitle="Performance metrics by doctor">
        <DataTable
          columns={[
            {
              key: 'name',
              header: 'Doctor Name',
              sortable: true,
            },
            {
              key: 'specialty',
              header: 'Specialty',
              sortable: true,
            },
            {
              key: 'episodes',
              header: 'Episodes',
              sortable: true,
              align: 'right',
            },
            {
              key: 'revenue',
              header: 'Revenue',
              sortable: true,
              format: (value) => `$${(value / 1000000).toFixed(2)}M`,
              align: 'right',
            },
            {
              key: 'avgEpisode',
              header: 'Avg per Episode',
              sortable: true,
              format: (value) => `$${value.toFixed(0)}`,
              align: 'right',
            },
          ]}
          data={topDoctors}
          searchable={true}
          exportable={true}
          pageSize={10}
        />
      </ChartCard>
    </div>
  );
}
