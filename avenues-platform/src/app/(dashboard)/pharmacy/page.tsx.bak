'use client';

import React, { useState } from 'react';
import {
  BarChart,
  Bar,
  LineChart,
  Line,
  AreaChart,
  Area,
  PieChart,
  Pie,
  Cell,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  Legend,
  ResponsiveContainer,
  ComposedChart,
} from 'recharts';
import { Download, TrendingUp, Pill, BarChart3, PieChart as PieChartIcon } from 'lucide-react';
import { StatCard } from '@/components/charts/stat-card';
import { ChartCard } from '@/components/dashboard/chart-card';
import { DataTable } from '@/components/dashboard/data-table';

// Sample pharmacy data
const monthlyPrescriptionData = [
  { month: 'Jan', prescriptions: 5200, revenue: 285000 },
  { month: 'Feb', prescriptions: 5450, revenue: 310000 },
  { month: 'Mar', prescriptions: 5850, revenue: 340000 },
  { month: 'Apr', prescriptions: 5620, revenue: 325000 },
  { month: 'May', prescriptions: 6100, revenue: 365000 },
  { month: 'Jun', prescriptions: 6450, revenue: 392000 },
  { month: 'Jul', prescriptions: 6650, revenue: 405000 },
  { month: 'Aug', prescriptions: 6200, revenue: 370000 },
  { month: 'Sep', prescriptions: 5950, revenue: 352000 },
  { month: 'Oct', prescriptions: 6350, revenue: 388000 },
  { month: 'Nov', prescriptions: 6750, revenue: 420000 },
  { month: 'Dec', prescriptions: 7050, revenue: 445000 },
];

const topDrugsByVolume = [
  { drug: 'Amoxicillin 500mg', volume: 8450 },
  { drug: 'Lisinopril 10mg', volume: 7620 },
  { drug: 'Ibuprofen 400mg', volume: 6890 },
  { drug: 'Metformin 850mg', volume: 6450 },
  { drug: 'Simvastatin 20mg', volume: 5980 },
  { drug: 'Paracetamol 500mg', volume: 5650 },
  { drug: 'Atorvastatin 40mg', volume: 5320 },
  { drug: 'Omeprazole 20mg', volume: 4950 },
];

const topDrugsByRevenue = [
  { drug: 'Insulin (Lantus) 100IU', revenue: 142000 },
  { drug: 'Clopidogrel 75mg', revenue: 128000 },
  { drug: 'Trastuzumab IV', revenue: 115000 },
  { drug: 'Semaglutide injection', revenue: 105000 },
  { drug: 'Bevacizumab IV', revenue: 98000 },
  { drug: 'Warfarin 5mg', revenue: 85000 },
  { drug: 'Enoxaparin 40mg', revenue: 72000 },
  { drug: 'Rivaroxaban 20mg', revenue: 68000 },
];

const prescriptionRevenueRatio = [
  { month: 'Jan', ratio: 54.8 },
  { month: 'Feb', ratio: 56.9 },
  { month: 'Mar', ratio: 58.1 },
  { month: 'Apr', ratio: 57.8 },
  { month: 'May', ratio: 59.8 },
  { month: 'Jun', ratio: 60.6 },
  { month: 'Jul', ratio: 60.9 },
  { month: 'Aug', ratio: 59.5 },
  { month: 'Sep', ratio: 59.2 },
  { month: 'Oct', ratio: 61.1 },
  { month: 'Nov', ratio: 62.2 },
  { month: 'Dec', ratio: 63.1 },
];

const pharmacyPercentageRevenue = [
  { month: 'Jan', percentage: 12.8 },
  { month: 'Feb', percentage: 13.2 },
  { month: 'Mar', percentage: 13.5 },
  { month: 'Apr', percentage: 13.2 },
  { month: 'May', percentage: 13.8 },
  { month: 'Jun', percentage: 14.1 },
  { month: 'Jul', percentage: 14.3 },
  { month: 'Aug', percentage: 13.9 },
  { month: 'Sep', percentage: 13.7 },
  { month: 'Oct', percentage: 14.2 },
  { month: 'Nov', percentage: 14.6 },
  { month: 'Dec', percentage: 14.9 },
];

const drugCategoryDistribution = [
  { name: 'Antibiotics', value: 22 },
  { name: 'Cardiovascular', value: 18 },
  { name: 'Analgesics', value: 15 },
  { name: 'Endocrine', value: 14 },
  { name: 'Anticoagulants', value: 12 },
  { name: 'Gastric', value: 9 },
  { name: 'Other', value: 10 },
];

const marginAnalysisData = [
  { category: 'Antibiotics', cost: 18000, revenue: 42000, margin: 57.1 },
  { category: 'Cardiovascular', cost: 22000, revenue: 48000, margin: 54.2 },
  { category: 'Analgesics', cost: 12000, revenue: 35000, margin: 65.7 },
  { category: 'Endocrine', cost: 16000, revenue: 38000, margin: 57.9 },
  { category: 'Anticoagulants', cost: 19000, revenue: 42000, margin: 54.8 },
  { category: 'Gastric', cost: 8000, revenue: 18000, margin: 55.6 },
];

const COLORS = ['#0d1f3c', '#00b8a0', '#f59e0b', '#e11d48', '#7c3aed', '#ec4899', '#8b5cf6', '#06b6d4'];

export default function PharmacyPage() {
  const [exportFormat, setExportFormat] = useState('csv');

  // Calculate KPIs
  const totalPrescriptions = monthlyPrescriptionData.reduce((sum, m) => sum + m.prescriptions, 0);
  const pharmacyRevenue = monthlyPrescriptionData.reduce((sum, m) => sum + m.revenue, 0);
  const avgRevenuePerRx = pharmacyRevenue / totalPrescriptions;
  const pharmacyGrowth = 11.8; // YoY growth
  const avgMargin = 58.5; // Average margin %

  const handleExport = () => {
    const csv = [
      'Pharmacy Analytics Export',
      new Date().toISOString().split('T')[0],
      '',
      'SUMMARY METRICS',
      `Total Prescriptions,${totalPrescriptions}`,
      `Pharmacy Revenue,$${pharmacyRevenue}`,
      `Average Revenue Per Rx,$${avgRevenuePerRx.toFixed(2)}`,
      `YoY Growth %,${pharmacyGrowth}`,
      `Average Margin %,${avgMargin}`,
      '',
      'MONTHLY DATA',
      'Month,Prescriptions,Revenue',
      ...monthlyPrescriptionData.map((d) => `${d.month},${d.prescriptions},${d.revenue}`),
    ].join('\n');

    const blob = new Blob([csv], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `pharmacy-analytics-${new Date().toISOString().split('T')[0]}.csv`;
    a.click();
    window.URL.revokeObjectURL(url);
  };

  return (
    <div className="space-y-6">
      {/* Page Header */}
      <div className="flex items-start justify-between">
        <div>
          <div className="flex items-center gap-3">
            <Pill className="h-8 w-8 text-teal-600" />
            <h1 className="text-3xl font-bold text-slate-900">Pharmacy Analytics</h1>
          </div>
          <p className="mt-2 text-slate-600">
            Prescription and pharmaceutical revenue performance analysis
          </p>
        </div>
        <button
          onClick={handleExport}
          className="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 transition-colors"
        >
          <Download className="h-4 w-4" />
          Export Report
        </button>
      </div>

      {/* KPI Cards */}
      <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        <StatCard
          title="Total Prescriptions"
          value={`${totalPrescriptions.toLocaleString()}`}
          change={9.3}
          trend="up"
          color="green"
          icon={Pill}
        />
        <StatCard
          title="Pharmacy Revenue"
          value={`$${(pharmacyRevenue / 1000).toFixed(1)}K`}
          change={pharmacyGrowth}
          trend="up"
          color="blue"
          icon={BarChart3}
        />
        <StatCard
          title="Avg Revenue Per Rx"
          value={`$${avgRevenuePerRx.toFixed(2)}`}
          change={2.1}
          trend="up"
          color="purple"
          icon={TrendingUp}
        />
        <StatCard
          title="Growth %"
          value={`${pharmacyGrowth}%`}
          change={pharmacyGrowth}
          trend="up"
          color="amber"
          icon={TrendingUp}
        />
      </div>

      {/* Monthly Prescription Trend */}
      <ChartCard title="Monthly Prescription Trend" subtitle="Prescription volume over 12 months">
        <ResponsiveContainer width="100%" height={300}>
          <BarChart data={monthlyPrescriptionData}>
            <CartesianGrid strokeDasharray="3 3" stroke="#e5e7eb" />
            <XAxis dataKey="month" stroke="#6b7280" style={{ fontSize: '12px' }} />
            <YAxis stroke="#6b7280" style={{ fontSize: '12px' }} />
            <Tooltip formatter={(value) => value.toLocaleString()} />
            <Bar dataKey="prescriptions" fill="#00b8a0" radius={[8, 8, 0, 0]} name="Prescriptions" />
          </BarChart>
        </ResponsiveContainer>
      </ChartCard>

      {/* Monthly Pharmacy Revenue */}
      <ChartCard title="Monthly Pharmacy Revenue Trend" subtitle="Revenue generation per month">
        <ResponsiveContainer width="100%" height={300}>
          <LineChart data={monthlyPrescriptionData}>
            <CartesianGrid strokeDasharray="3 3" stroke="#e5e7eb" />
            <XAxis dataKey="month" stroke="#6b7280" style={{ fontSize: '12px' }} />
            <YAxis stroke="#6b7280" style={{ fontSize: '12px' }} />
            <Tooltip formatter={(value) => `$${value.toLocaleString()}`} />
            <Line
              type="monotone"
              dataKey="revenue"
              stroke="#0d1f3c"
              strokeWidth={2}
              dot={{ fill: '#0d1f3c', r: 4 }}
              name="Pharmacy Revenue"
            />
          </LineChart>
        </ResponsiveContainer>
      </ChartCard>

      {/* Top Drugs By Volume and Revenue */}
      <div className="grid gap-6 lg:grid-cols-2">
        <ChartCard title="Top Drugs by Volume" subtitle="Prescription volume ranking">
          <ResponsiveContainer width="100%" height={320}>
            <BarChart
              data={topDrugsByVolume}
              layout="vertical"
              margin={{ top: 5, right: 30, left: 150, bottom: 5 }}
            >
              <CartesianGrid strokeDasharray="3 3" stroke="#e5e7eb" />
              <XAxis type="number" stroke="#6b7280" style={{ fontSize: '12px' }} />
              <YAxis dataKey="drug" type="category" stroke="#6b7280" width={130} style={{ fontSize: '10px' }} />
              <Tooltip />
              <Bar dataKey="volume" fill="#00b8a0" radius={[0, 8, 8, 0]} />
            </BarChart>
          </ResponsiveContainer>
        </ChartCard>

        <ChartCard title="Top Drugs by Revenue" subtitle="Revenue contribution ranking">
          <ResponsiveContainer width="100%" height={320}>
            <BarChart
              data={topDrugsByRevenue}
              layout="vertical"
              margin={{ top: 5, right: 30, left: 150, bottom: 5 }}
            >
              <CartesianGrid strokeDasharray="3 3" stroke="#e5e7eb" />
              <XAxis type="number" stroke="#6b7280" style={{ fontSize: '12px' }} />
              <YAxis dataKey="drug" type="category" stroke="#6b7280" width={130} style={{ fontSize: '10px' }} />
              <Tooltip formatter={(value) => `$${value.toLocaleString()}`} />
              <Bar dataKey="revenue" fill="#0d1f3c" radius={[0, 8, 8, 0]} />
            </BarChart>
          </ResponsiveContainer>
        </ChartCard>
      </div>

      {/* Prescription to Revenue Ratio */}
      <ChartCard title="Prescription to Revenue Ratio Trend" subtitle="Revenue per prescription over time">
        <ResponsiveContainer width="100%" height={300}>
          <AreaChart data={prescriptionRevenueRatio}>
            <defs>
              <linearGradient id="colorRatio" x1="0" y1="0" x2="0" y2="1">
                <stop offset="5%" stopColor="#7c3aed" stopOpacity={0.8} />
                <stop offset="95%" stopColor="#7c3aed" stopOpacity={0.1} />
              </linearGradient>
            </defs>
            <CartesianGrid strokeDasharray="3 3" stroke="#e5e7eb" />
            <XAxis dataKey="month" stroke="#6b7280" style={{ fontSize: '12px' }} />
            <YAxis stroke="#6b7280" style={{ fontSize: '12px' }} />
            <Tooltip formatter={(value) => `$${value.toFixed(2)}`} />
            <Area
              type="monotone"
              dataKey="ratio"
              stroke="#7c3aed"
              fillOpacity={1}
              fill="url(#colorRatio)"
              name="Avg Revenue per Rx"
            />
          </AreaChart>
        </ResponsiveContainer>
      </ChartCard>

      {/* Pharmacy as % of Total Revenue */}
      <ChartCard title="Pharmacy as % of Total Revenue" subtitle="Monthly contribution to organizational revenue">
        <ResponsiveContainer width="100%" height={300}>
          <AreaChart data={pharmacyPercentageRevenue}>
            <defs>
              <linearGradient id="colorPharmacy" x1="0" y1="0" x2="0" y2="1">
                <stop offset="5%" stopColor="#f59e0b" stopOpacity={0.8} />
                <stop offset="95%" stopColor="#f59e0b" stopOpacity={0.1} />
              </linearGradient>
            </defs>
            <CartesianGrid strokeDasharray="3 3" stroke="#e5e7eb" />
            <XAxis dataKey="month" stroke="#6b7280" style={{ fontSize: '12px' }} />
            <YAxis stroke="#6b7280" style={{ fontSize: '12px' }} />
            <Tooltip formatter={(value) => `${value.toFixed(1)}%`} />
            <Area
              type="monotone"
              dataKey="percentage"
              stroke="#f59e0b"
              fillOpacity={1}
              fill="url(#colorPharmacy)"
              name="Percentage of Total Revenue"
            />
          </AreaChart>
        </ResponsiveContainer>
      </ChartCard>

      {/* Drug Category Distribution */}
      <div className="grid gap-6 lg:grid-cols-2">
        <ChartCard title="Drug Category Distribution" subtitle="Prescription breakdown by category">
          <ResponsiveContainer width="100%" height={300}>
            <PieChart>
              <Pie
                data={drugCategoryDistribution}
                cx="50%"
                cy="50%"
                labelLine={false}
                label={({ name, value }) => `${name}: ${value}%`}
                outerRadius={80}
                fill="#8884d8"
                dataKey="value"
              >
                {drugCategoryDistribution.map((entry, index) => (
                  <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
                ))}
              </Pie>
              <Tooltip formatter={(value) => `${value}%`} />
            </PieChart>
          </ResponsiveContainer>
        </ChartCard>

        {/* Margin Summary */}
        <div className="rounded-lg border border-gray-200 bg-white p-6">
          <h3 className="text-lg font-semibold text-gray-900 mb-4">Margin Analysis Summary</h3>
          <div className="space-y-3">
            <div className="flex justify-between items-center pb-3 border-b border-gray-100">
              <span className="text-sm font-medium text-gray-700">Average Gross Margin</span>
              <span className="text-2xl font-bold text-green-600">{avgMargin}%</span>
            </div>
            <div className="grid grid-cols-2 gap-4">
              <div>
                <p className="text-xs text-gray-600 mb-1">Highest Margin</p>
                <p className="text-lg font-semibold text-gray-900">Analgesics</p>
                <p className="text-sm text-green-600">65.7%</p>
              </div>
              <div>
                <p className="text-xs text-gray-600 mb-1">Lowest Margin</p>
                <p className="text-lg font-semibold text-gray-900">Cardiovascular</p>
                <p className="text-sm text-orange-600">54.2%</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Margin Analysis by Category */}
      <ChartCard title="Margin Analysis by Drug Category" subtitle="Cost vs revenue and margins">
        <ResponsiveContainer width="100%" height={350}>
          <ComposedChart data={marginAnalysisData}>
            <CartesianGrid strokeDasharray="3 3" stroke="#e5e7eb" />
            <XAxis dataKey="category" stroke="#6b7280" style={{ fontSize: '12px' }} />
            <YAxis stroke="#6b7280" style={{ fontSize: '12px' }} />
            <Tooltip formatter={(value) => `$${value.toLocaleString()}`} />
            <Legend />
            <Bar dataKey="cost" fill="#e11d48" name="Cost" radius={[8, 0, 0, 0]} />
            <Bar dataKey="revenue" fill="#00b8a0" name="Revenue" radius={[8, 0, 0, 0]} />
            <Line type="monotone" dataKey="margin" stroke="#7c3aed" strokeWidth={2} name="Margin %" yAxisId="right" />
            <YAxis yAxisId="right" orientation="right" stroke="#6b7280" />
          </ComposedChart>
        </ResponsiveContainer>
      </ChartCard>

      {/* Performance Metrics Cards */}
      <div className="grid gap-4 md:grid-cols-3">
        <div className="rounded-lg border border-gray-200 bg-white p-6">
          <h3 className="text-sm font-medium text-gray-600">Avg Prescriptions/Month</h3>
          <p className="mt-3 text-3xl font-bold text-gray-900">{(totalPrescriptions / 12).toFixed(0)}</p>
          <p className="mt-2 text-xs text-gray-500">Based on 12-month period</p>
        </div>
        <div className="rounded-lg border border-gray-200 bg-white p-6">
          <h3 className="text-sm font-medium text-gray-600">Avg Monthly Revenue</h3>
          <p className="mt-3 text-3xl font-bold text-gray-900">${(pharmacyRevenue / 12 / 1000).toFixed(0)}K</p>
          <p className="mt-2 text-xs text-gray-500">Average per month</p>
        </div>
        <div className="rounded-lg border border-gray-200 bg-white p-6">
          <h3 className="text-sm font-medium text-gray-600">Rx Volume Growth</h3>
          <p className="mt-3 text-3xl font-bold text-green-600">+9.3%</p>
          <p className="mt-2 text-xs text-gray-500">YoY prescription growth</p>
        </div>
      </div>
    </div>
  );
}
