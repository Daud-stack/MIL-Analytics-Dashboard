'use client';

import { useState, useMemo } from 'react';
import {
  LineChart,
  Line,
  AreaChart,
  Area,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  Legend,
  ResponsiveContainer,
  BarChart,
  Bar,
} from 'recharts';
import { TrendingUp, Download } from 'lucide-react';

type Metric = 'revenue' | 'admissions' | 'occupancy' | 'theatre' | 'pharmacy';

interface ForecastData {
  month: string;
  actual: number;
  forecast: number;
  lower95: number;
  upper95: number;
  moving_avg?: number;
}

interface SeasonalData {
  month: string;
  trend: number;
  seasonal: number;
  residual: number;
}

// Sample historical and forecast data
const generateForecastData = (metric: Metric): ForecastData[] => {
  const baseData: Record<Metric, { historical: number[]; scale: number }> = {
    revenue: {
      historical: [2100, 2150, 2200, 2180, 2250, 2300, 2400, 2420, 2450, 2480, 2520, 2580],
      scale: 1000,
    },
    admissions: {
      historical: [200, 210, 215, 205, 225, 240, 250, 245, 260, 270, 280, 290],
      scale: 1,
    },
    occupancy: {
      historical: [65, 68, 70, 69, 72, 75, 73, 72, 70, 68, 70, 72],
      scale: 1,
    },
    theatre: {
      historical: [60, 65, 70, 68, 75, 80, 78, 75, 72, 70, 75, 80],
      scale: 1,
    },
    pharmacy: {
      historical: [380, 395, 410, 405, 430, 450, 460, 455, 440, 435, 450, 475],
      scale: 1,
    },
  };

  const { historical, scale } = baseData[metric];
  const months = [
    'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
    'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec',
    'Jan+1', 'Feb+1', 'Mar+1', 'Apr+1', 'May+1', 'Jun+1',
  ];

  const data: ForecastData[] = [];

  // Historical data
  historical.forEach((actual, idx) => {
    data.push({
      month: months[idx],
      actual,
      forecast: actual,
      lower95: actual * 0.95,
      upper95: actual * 1.05,
    });
  });

  // Forecast data
  let lastValue = historical[historical.length - 1];
  for (let i = 0; i < 6; i++) {
    const growth = (Math.random() - 0.45) * 5;
    const forecast = lastValue * (1 + growth / 100);
    const variance = forecast * 0.08;

    data.push({
      month: months[historical.length + i],
      actual: NaN,
      forecast: Math.round(forecast),
      lower95: Math.round(forecast - variance),
      upper95: Math.round(forecast + variance),
    });

    lastValue = forecast;
  }

  return data;
};

const generateSeasonalData = (metric: Metric): SeasonalData[] => {
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const baseTrend: Record<Metric, number[]> = {
    revenue: [2000, 2050, 2100, 2150, 2200, 2250, 2300, 2350, 2400, 2450, 2500, 2550],
    admissions: [200, 205, 210, 215, 220, 225, 230, 235, 240, 245, 250, 255],
    occupancy: [70, 71, 72, 73, 74, 75, 74, 73, 72, 71, 70, 71],
    theatre: [70, 71, 72, 73, 74, 75, 74, 73, 72, 71, 70, 71],
    pharmacy: [420, 425, 430, 435, 440, 445, 450, 455, 460, 465, 470, 475],
  };

  const seasonal: Record<Metric, number[]> = {
    revenue: [0, 5, 10, 5, 20, 25, 50, 40, 30, 20, 10, 5],
    admissions: [-10, -5, 5, -5, 10, 15, 20, 15, 10, 5, -10, -5],
    occupancy: [-3, -2, 0, 2, 3, 4, 2, 0, -2, -3, -4, -2],
    theatre: [-4, -2, 2, 0, 5, 6, 4, 2, 0, -2, -4, -3],
    pharmacy: [-20, -10, 5, 0, 15, 20, 25, 20, 10, 5, -10, -15],
  };

  return months.map((month, idx) => ({
    month,
    trend: baseTrend[metric][idx],
    seasonal: seasonal[metric][idx],
    residual: Math.random() * 4 - 2,
  }));
};

export default function ForecastPage() {
  const [metric, setMetric] = useState<Metric>('revenue');
  const [horizon, setHorizon] = useState(6);
  const [showMovingAvg, setShowMovingAvg] = useState(false);
  const [benchmarkType, setBenchmarkType] = useState<'holt-winters' | 'arima'>('holt-winters');
  const [alpha, setAlpha] = useState(0.3);
  const [beta, setBeta] = useState(0.1);
  const [gamma, setGamma] = useState(0.1);

  const metricLabels: Record<Metric, string> = {
    revenue: 'Revenue (R\'000)',
    admissions: 'Admissions',
    occupancy: 'Occupancy (%)',
    theatre: 'Theatre Cases',
    pharmacy: 'Pharmacy Revenue (R\'000)',
  };

  const forecastData = useMemo(() => {
    const data = generateForecastData(metric);
    // Filter to show only first 12 historical + selected horizon
    return data.slice(0, 12 + horizon);
  }, [metric, horizon]);

  const seasonalData = generateSeasonalData(metric);

  // Calculate metrics
  const historicalData = forecastData.slice(0, 12);
  const forecastedData = forecastData.slice(12);

  const calculateMetrics = () => {
    let sumSquaredError = 0;
    let sumAbsoluteError = 0;
    let percentErrors = [];

    historicalData.forEach((d) => {
      if (!isNaN(d.forecast)) {
        const error = Math.abs(d.actual - d.forecast);
        sumSquaredError += error * error;
        sumAbsoluteError += error;
        percentErrors.push((error / d.actual) * 100);
      }
    });

    const rmse = Math.sqrt(sumSquaredError / historicalData.length);
    const mae = sumAbsoluteError / historicalData.length;
    const mape = percentErrors.reduce((a, b) => a + b, 0) / percentErrors.length;

    return { rmse: rmse.toFixed(2), mae: mae.toFixed(2), mape: mape.toFixed(2) };
  };

  const metrics = calculateMetrics();

  const handleExport = () => {
    const csv = [
      ['Month', 'Actual', 'Forecast', 'Lower 95%', 'Upper 95%'],
      ...forecastData.map((d) => [
        d.month,
        isNaN(d.actual) ? '' : d.actual,
        d.forecast,
        d.lower95,
        d.upper95,
      ]),
    ]
      .map((row) => row.join(','))
      .join('\n');

    const blob = new Blob([csv], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `forecast-${metric}.csv`;
    a.click();
  };

  return (
    <div className="min-h-screen bg-gray-50 p-8">
      <div className="max-w-7xl mx-auto">
        {/* Header */}
        <div className="flex items-center justify-between mb-8">
          <div className="flex items-center gap-3">
            <TrendingUp className="w-8 h-8 text-blue-600" />
            <h1 className="text-3xl font-bold text-gray-900">Forecasting</h1>
          </div>
          <button
            onClick={handleExport}
            className="flex items-center gap-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
          >
            <Download className="w-4 h-4" />
            Export CSV
          </button>
        </div>

        {/* Controls */}
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">
          {/* Metric Selector */}
          <div className="bg-white rounded-lg shadow-sm p-4">
            <label className="block text-sm font-medium text-gray-700 mb-3">
              Select Metric
            </label>
            <select
              value={metric}
              onChange={(e) => setMetric(e.target.value as Metric)}
              className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            >
              {Object.entries(metricLabels).map(([key, label]) => (
                <option key={key} value={key}>
                  {label}
                </option>
              ))}
            </select>
          </div>

          {/* Forecast Horizon */}
          <div className="bg-white rounded-lg shadow-sm p-4">
            <label className="block text-sm font-medium text-gray-700 mb-3">
              Forecast Horizon: {horizon} months
            </label>
            <input
              type="range"
              min="3"
              max="12"
              value={horizon}
              onChange={(e) => setHorizon(parseInt(e.target.value))}
              className="w-full"
            />
          </div>

          {/* Forecast Method */}
          <div className="bg-white rounded-lg shadow-sm p-4">
            <label className="block text-sm font-medium text-gray-700 mb-3">
              Method
            </label>
            <select
              value={benchmarkType}
              onChange={(e) => setBenchmarkType(e.target.value as 'holt-winters' | 'arima')}
              className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            >
              <option value="holt-winters">Holt-Winters</option>
              <option value="arima">ARIMA</option>
            </select>
          </div>
        </div>

        {/* Model Parameters */}
        {benchmarkType === 'holt-winters' && (
          <div className="grid grid-cols-3 gap-4 mb-6">
            <div className="bg-white rounded-lg shadow-sm p-4">
              <label className="block text-sm font-medium text-gray-700 mb-3">
                Alpha (Level): {alpha.toFixed(2)}
              </label>
              <input
                type="range"
                min="0"
                max="1"
                step="0.05"
                value={alpha}
                onChange={(e) => setAlpha(parseFloat(e.target.value))}
                className="w-full"
              />
              <p className="text-xs text-gray-500 mt-2">Smoothing for level</p>
            </div>

            <div className="bg-white rounded-lg shadow-sm p-4">
              <label className="block text-sm font-medium text-gray-700 mb-3">
                Beta (Trend): {beta.toFixed(2)}
              </label>
              <input
                type="range"
                min="0"
                max="1"
                step="0.05"
                value={beta}
                onChange={(e) => setBeta(parseFloat(e.target.value))}
                className="w-full"
              />
              <p className="text-xs text-gray-500 mt-2">Smoothing for trend</p>
            </div>

            <div className="bg-white rounded-lg shadow-sm p-4">
              <label className="block text-sm font-medium text-gray-700 mb-3">
                Gamma (Seasonal): {gamma.toFixed(2)}
              </label>
              <input
                type="range"
                min="0"
                max="1"
                step="0.05"
                value={gamma}
                onChange={(e) => setGamma(parseFloat(e.target.value))}
                className="w-full"
              />
              <p className="text-xs text-gray-500 mt-2">Smoothing for seasonality</p>
            </div>
          </div>
        )}

        {/* Main Forecast Chart */}
        <div className="bg-white rounded-lg shadow-sm p-6 mb-6">
          <div className="flex items-center justify-between mb-4">
            <h2 className="text-lg font-semibold text-gray-900">
              {metricLabels[metric]} - Forecast with Confidence Interval
            </h2>
            <label className="flex items-center gap-2 text-sm">
              <input
                type="checkbox"
                checked={showMovingAvg}
                onChange={(e) => setShowMovingAvg(e.target.checked)}
                className="rounded"
              />
              Show Moving Average
            </label>
          </div>

          <ResponsiveContainer width="100%" height={400}>
            <AreaChart data={forecastData}>
              <defs>
                <linearGradient id="colorConfidence" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="5%" stopColor="#93c5fd" stopOpacity={0.3} />
                  <stop offset="95%" stopColor="#93c5fd" stopOpacity={0} />
                </linearGradient>
              </defs>
              <CartesianGrid strokeDasharray="3 3" />
              <XAxis dataKey="month" />
              <YAxis />
              <Tooltip
                formatter={(value) => {
                  if (typeof value === 'number') {
                    return value.toFixed(0);
                  }
                  return value;
                }}
              />
              <Legend />
              {/* Confidence Interval Area */}
              <Area
                type="monotone"
                dataKey="upper95"
                fill="none"
                stroke="none"
                isAnimationActive={false}
              />
              <Area
                type="monotone"
                dataKey="lower95"
                fill="url(#colorConfidence)"
                stroke="none"
                isAnimationActive={false}
              />
              {/* Actual Data */}
              <Line
                type="monotone"
                dataKey="actual"
                stroke="#10b981"
                strokeWidth={2}
                dot={false}
                isAnimationActive={false}
                name="Actual"
              />
              {/* Forecast */}
              <Line
                type="monotone"
                dataKey="forecast"
                stroke="#3b82f6"
                strokeWidth={2}
                strokeDasharray="5 5"
                dot={false}
                isAnimationActive={false}
                name="Forecast"
              />
              {showMovingAvg && (
                <Line
                  type="monotone"
                  dataKey="moving_avg"
                  stroke="#f59e0b"
                  strokeWidth={1}
                  dot={false}
                  isAnimationActive={false}
                  name="7-Month MA"
                />
              )}
            </AreaChart>
          </ResponsiveContainer>
        </div>

        {/* Accuracy Metrics */}
        <div className="grid grid-cols-3 gap-4 mb-6">
          <div className="bg-white rounded-lg shadow-sm p-4">
            <p className="text-xs text-gray-600 font-medium">RMSE</p>
            <p className="text-2xl font-bold text-gray-900">{metrics.rmse}</p>
            <p className="text-xs text-gray-500 mt-1">Root Mean Square Error</p>
          </div>
          <div className="bg-white rounded-lg shadow-sm p-4">
            <p className="text-xs text-gray-600 font-medium">MAE</p>
            <p className="text-2xl font-bold text-gray-900">{metrics.mae}</p>
            <p className="text-xs text-gray-500 mt-1">Mean Absolute Error</p>
          </div>
          <div className="bg-white rounded-lg shadow-sm p-4">
            <p className="text-xs text-gray-600 font-medium">MAPE</p>
            <p className="text-2xl font-bold text-gray-900">{metrics.mape}%</p>
            <p className="text-xs text-gray-500 mt-1">Mean Absolute % Error</p>
          </div>
        </div>

        {/* Seasonal Decomposition */}
        <div className="bg-white rounded-lg shadow-sm p-6">
          <h2 className="text-lg font-semibold text-gray-900 mb-4">
            Seasonal Decomposition
          </h2>

          <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
            {/* Trend */}
            <div>
              <h3 className="text-sm font-medium text-gray-700 mb-3">Trend</h3>
              <ResponsiveContainer width="100%" height={250}>
                <LineChart data={seasonalData}>
                  <CartesianGrid strokeDasharray="3 3" />
                  <XAxis dataKey="month" />
                  <YAxis />
                  <Tooltip />
                  <Line
                    type="monotone"
                    dataKey="trend"
                    stroke="#3b82f6"
                    strokeWidth={2}
                    dot={false}
                  />
                </LineChart>
              </ResponsiveContainer>
            </div>

            {/* Seasonal */}
            <div>
              <h3 className="text-sm font-medium text-gray-700 mb-3">Seasonal</h3>
              <ResponsiveContainer width="100%" height={250}>
                <BarChart data={seasonalData}>
                  <CartesianGrid strokeDasharray="3 3" />
                  <XAxis dataKey="month" />
                  <YAxis />
                  <Tooltip />
                  <Bar dataKey="seasonal" fill="#10b981" />
                </BarChart>
              </ResponsiveContainer>
            </div>

            {/* Residual */}
            <div>
              <h3 className="text-sm font-medium text-gray-700 mb-3">Residual</h3>
              <ResponsiveContainer width="100%" height={250}>
                <BarChart data={seasonalData}>
                  <CartesianGrid strokeDasharray="3 3" />
                  <XAxis dataKey="month" />
                  <YAxis />
                  <Tooltip />
                  <Bar dataKey="residual" fill="#f59e0b" />
                </BarChart>
              </ResponsiveContainer>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
