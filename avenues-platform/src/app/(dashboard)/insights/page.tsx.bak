'use client';

import { useState, useMemo } from 'react';
import {
  BarChart,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
  LineChart,
  Line,
} from 'recharts';
import { AlertCircle, TrendingUp, Info, AlertTriangle, Zap, RefreshCw, ChevronDown } from 'lucide-react';

type InsightType = 'good' | 'warning' | 'bad' | 'info' | 'violet';

interface Insight {
  id: string;
  type: InsightType;
  title: string;
  description: string;
  metric: string;
  metricValue: string;
  timestamp: string;
  details?: string;
  trend?: number;
  sparkData?: Array<{ value: number }>;
}

