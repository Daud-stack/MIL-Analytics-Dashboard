export default function InsightsPage() {
  const [filter, setFilter] = useState<'all' | InsightType>('all');
  const [expandedId, setExpandedId] = useState<string | null>(null);
  const [sortBy, setSortBy] = useState<'recency' | 'severity'>('recency');
  const [isRefreshing, setIsRefreshing] = useState(false);

  const filteredAndSortedInsights = useMemo(() => {
    let filtered = sampleInsights;

    if (filter !== 'all') {
      filtered = filtered.filter((insight) => insight.type === filter);
    }

    if (sortBy === 'severity') {
      const severityOrder: Record<InsightType, number> = {
        bad: 0,
        warning: 1,
        good: 2,
        info: 3,
        violet: 4,
      };
      filtered.sort(
        (a, b) => severityOrder[a.type] - severityOrder[b.type]
      );
    } else {
      filtered.sort(
        (a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime()
      );
    }

    return filtered;
  }, [filter, sortBy]);

  const handleRefresh = async () => {
    setIsRefreshing(true);
    await new Promise((resolve) => setTimeout(resolve, 1000));
    setIsRefreshing(false);
  };

  const getCardStyles = (type: InsightType) => {
    const baseStyles = 'p-4 rounded-lg border cursor-pointer transition-all';
    const styles: Record<InsightType, string> = {
      good: 'bg-green-50 border-green-200 hover:border-green-400',
      warning: 'bg-amber-50 border-amber-200 hover:border-amber-400',
      bad: 'bg-red-50 border-red-200 hover:border-red-400',
      info: 'bg-teal-50 border-teal-200 hover:border-teal-400',
      violet: 'bg-violet-50 border-violet-200 hover:border-violet-400',
    };
    return `${baseStyles} ${styles[type]}`;
  };

  const getIconColor = (type: InsightType) => {
    const colors: Record<InsightType, string> = {
      good: 'text-green-600',
      warning: 'text-amber-600',
      bad: 'text-red-600',
      info: 'text-teal-600',
      violet: 'text-violet-600',
    };
    return colors[type];
  };

  const getMetricColor = (type: InsightType) => {
    const colors: Record<InsightType, string> = {
      good: 'text-green-700',
      warning: 'text-amber-700',
      bad: 'text-red-700',
      info: 'text-teal-700',
      violet: 'text-violet-700',
    };
    return colors[type];
  };

  return (
    <div className="min-h-screen bg-gray-50 p-8">
      <div className="max-w-7xl mx-auto">
        {/* Header */}
        <div className="flex items-center justify-between mb-8">
          <div className="flex items-center gap-3">
            <Zap className="w-8 h-8 text-blue-600" />
            <h1 className="text-3xl font-bold text-gray-900">AI Insights</h1>
          </div>
          <button
            onClick={handleRefresh}
            disabled={isRefreshing}
            className="flex items-center gap-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:bg-gray-400 transition-all"
          >
            <RefreshCw className={`w-4 h-4 ${isRefreshing ? 'animate-spin' : ''}`} />
            Refresh
          </button>
        </div>

        {/* Controls */}
        <div className="bg-white rounded-lg shadow-sm p-4 mb-6">
          <div className="flex flex-wrap gap-4 items-center">
            <div>
              <label className="text-sm font-medium text-gray-700 mr-3">
                Filter by Type:
              </label>
              <div className="inline-flex gap-2 flex-wrap">
                {(['all', 'good', 'warning', 'bad', 'info', 'violet'] as const).map(
                  (type) => (
                    <button
                      key={type}
                      onClick={() => setFilter(type)}
                      className={`px-3 py-1 rounded text-sm font-medium transition-all capitalize ${
                        filter === type
                          ? 'bg-blue-600 text-white'
                          : 'bg-gray-200 text-gray-700 hover:bg-gray-300'
                      }`}
                    >
                      {type}
                    </button>
                  )
                )}
              </div>
            </div>
            <div className="flex-1" />
            <div>
              <label className="text-sm font-medium text-gray-700 mr-3">
                Sort by:
              </label>
              <select
                value={sortBy}
                onChange={(e) => setSortBy(e.target.value as 'recency' | 'severity')}
                className="px-3 py-1 border border-gray-300 rounded text-sm bg-white hover:border-gray-400"
              >
                <option value="recency">Recency</option>
                <option value="severity">Severity</option>
              </select>
            </div>
          </div>
        </div>

        {/* Insights Grid */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {filteredAndSortedInsights.map((insight) => (
            <div
              key={insight.id}
              className={getCardStyles(insight.type)}
              onClick={() =>
                setExpandedId(expandedId === insight.id ? null : insight.id)
              }
            >
              <div className="flex items-start justify-between mb-3">
                <div className="flex items-start gap-3 flex-1">
                  {insight.type === 'good' && (
                    <TrendingUp className={`w-5 h-5 ${getIconColor(insight.type)} mt-1`} />
                  )}
                  {insight.type === 'warning' && (
                    <AlertTriangle
                      className={`w-5 h-5 ${getIconColor(insight.type)} mt-1`}
                    />
                  )}
                  {insight.type === 'bad' && (
                    <AlertCircle className={`w-5 h-5 ${getIconColor(insight.type)} mt-1`} />
                  )}
                  {(insight.type === 'info' || insight.type === 'violet') && (
                    <Info className={`w-5 h-5 ${getIconColor(insight.type)} mt-1`} />
                  )}
                  <div className="flex-1">
                    <h3 className="font-semibold text-gray-900">{insight.title}</h3>
                    <p className="text-xs text-gray-500 mt-1">{insight.timestamp}</p>
                  </div>
                </div>
                <ChevronDown
                  className={`w-4 h-4 text-gray-400 transition-transform ${
                    expandedId === insight.id ? 'rotate-180' : ''
                  }`}
                />
              </div>

              <p className="text-sm text-gray-600 mb-3">{insight.description}</p>

              <div className="flex items-baseline justify-between">
                <span className="text-xs text-gray-500">{insight.metric}</span>
                <span className={`text-xl font-bold ${getMetricColor(insight.type)}`}>
                  {insight.metricValue}
                </span>
              </div>

              {/* Spark Chart */}
              {insight.sparkData && (
                <div className="mt-3 -mx-4 -mb-4">
                  <ResponsiveContainer width="100%" height={40}>
                    <LineChart data={insight.sparkData}>
                      <Line
                        type="monotone"
                        dataKey="value"
                        stroke={
                          insight.type === 'good'
                            ? '#16a34a'
                            : insight.type === 'warning'
                              ? '#d97706'
                              : insight.type === 'bad'
                                ? '#dc2626'
                                : insight.type === 'violet'
                                  ? '#7c3aed'
                                  : '#0d9488'
                        }
                        dot={false}
                        isAnimationActive={false}
                      />
                    </LineChart>
                  </ResponsiveContainer>
                </div>
              )}

              {/* Expanded Details */}
              {expandedId === insight.id && (
                <div className="mt-4 pt-4 border-t border-gray-200">
                  <div className="text-sm space-y-2">
                    <p>
                      <span className="font-semibold text-gray-700">Status:</span>{' '}
                      <span className={getMetricColor(insight.type)} className="font-semibold">
                        {insight.type.toUpperCase()}
                      </span>
                    </p>
                    {insight.trend !== undefined && (
                      <p>
                        <span className="font-semibold text-gray-700">Trend:</span>{' '}
                        <span
                          className={insight.trend > 0 ? 'text-green-600' : 'text-red-600'}
                        >
                          {insight.trend > 0 ? '+' : ''}{insight.trend}%
                        </span>
                      </p>
                    )}
                    <p className="text-gray-700 pt-2">
                      This insight was generated based on automated analysis of your
                      clinic's operational and financial metrics. Consider reviewing the
                      underlying data for more details.
                    </p>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>

        {/* Summary Stats */}
        <div className="mt-8 grid grid-cols-4 gap-4">
          <div className="bg-white rounded-lg shadow-sm p-4">
            <p className="text-xs text-gray-600 font-medium">Total Insights</p>
            <p className="text-2xl font-bold text-gray-900">{sampleInsights.length}</p>
          </div>
          <div className="bg-white rounded-lg shadow-sm p-4">
            <p className="text-xs text-gray-600 font-medium">Good</p>
            <p className="text-2xl font-bold text-green-600">
              {sampleInsights.filter((i) => i.type === 'good').length}
            </p>
          </div>
          <div className="bg-white rounded-lg shadow-sm p-4">
            <p className="text-xs text-gray-600 font-medium">Warnings</p>
            <p className="text-2xl font-bold text-amber-600">
              {sampleInsights.filter((i) => i.type === 'warning').length}
            </p>
          </div>
          <div className="bg-white rounded-lg shadow-sm p-4">
            <p className="text-xs text-gray-600 font-medium">Critical</p>
            <p className="text-2xl font-bold text-red-600">
              {sampleInsights.filter((i) => i.type === 'bad').length}
            </p>
          </div>
        </div>
      </div>
    </div>
  );
}
