import { BarChartComponent } from '@/components/charts/bar-chart';
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/ui/table';

const monthlyOccupancyData = [
  { month: 'Jan', occupancy: 72, benchmark: 75, patientDays: 2840 },
  { month: 'Feb', occupancy: 75, benchmark: 75, patientDays: 2950 },
  { month: 'Mar', occupancy: 78, benchmark: 75, patientDays: 3065 },
  { month: 'Apr', occupancy: 76, benchmark: 75, patientDays: 2985 },
  { month: 'May', occupancy: 81, benchmark: 75, patientDays: 3185 },
  { month: 'Jun', occupancy: 79, benchmark: 75, patientDays: 3095 },
  { month: 'Jul', occupancy: 83, benchmark: 75, patientDays: 3255 },
  { month: 'Aug', occupancy: 80, benchmark: 75, patientDays: 3140 },
  { month: 'Sep', occupancy: 77, benchmark: 75, patientDays: 3015 },
  { month: 'Oct', occupancy: 74, benchmark: 75, patientDays: 2895 },
  { month: 'Nov', occupancy: 73, benchmark: 75, patientDays: 2825 },
  { month: 'Dec', occupancy: 76, benchmark: 75, patientDays: 2975 },
];

const wardPatientDays = [
  { ward: 'Cardiology', jan: 285, feb: 298, mar: 312, apr: 301, may: 325, jun: 315, jul: 338, aug: 320, sep: 305, oct: 290, nov: 280, dec: 295 },
  { ward: 'Orthopedics', jan: 245, feb: 258, mar: 272, apr: 265, may: 285, jun: 278, jul: 295, aug: 280, sep: 268, oct: 250, nov: 242, dec: 255 },
  { ward: 'Pediatrics', jan: 215, feb: 228, mar: 238, apr: 232, may: 248, jun: 240, jul: 258, aug: 245, sep: 235, oct: 218, nov: 210, dec: 228 },
  { ward: 'ICU', jan: 165, feb: 172, mar: 185, apr: 180, may: 195, jun: 188, jul: 205, aug: 195, sep: 185, oct: 172, nov: 165, dec: 178 },
  { ward: 'General Ward', jan: 295, feb: 308, mar: 325, apr: 315, may: 338, jun: 328, jul: 350, aug: 335, sep: 320, oct: 298, nov: 285, dec: 305 },
  { ward: 'Obstetrics', jan: 195, feb: 205, mar: 215, apr: 210, may: 228, jun: 220, jul: 235, aug: 222, sep: 212, oct: 198, nov: 190, dec: 205 },
];

const yoyOccupancyData = [
  { month: 'Jan', year2024: 68, year2025: 70, year2026: 72 },
  { month: 'Feb', year2024: 71, year2025: 73, year2026: 75 },
  { month: 'Mar', year2024: 75, year2025: 76, year2026: 78 },
  { month: 'Apr', year2024: 73, year2025: 74, year2026: 76 },
  { month: 'May', year2024: 78, year2025: 79, year2026: 81 },
  { month: 'Jun', year2024: 76, year2025: 77, year2026: 79 },
  { month: 'Jul', year2024: 80, year2025: 81, year2026: 83 },
  { month: 'Aug', year2024: 77, year2025: 78, year2026: 80 },
  { month: 'Sep', year2024: 74, year2025: 75, year2026: 77 },
  { month: 'Oct', year2024: 71, year2025: 72, year2026: 74 },
  { month: 'Nov', year2024: 70, year2025: 71, year2026: 73 },
  { month: 'Dec', year2024: 73, year2025: 74, year2026: 76 },
];

const heatmapData = [
  { ward: 'Cardiology', jan: 92, feb: 96, mar: 101, apr: 97, may: 105, jun: 102, jul: 110, aug: 104, sep: 99, oct: 94, nov: 91, dec: 96 },
  { ward: 'Orthopedics', jan: 79, feb: 83, mar: 88, apr: 86, may: 92, jun: 90, jul: 96, aug: 91, sep: 87, oct: 81, nov: 78, dec: 83 },
  { ward: 'Pediatrics', jan: 70, feb: 74, mar: 77, apr: 75, may: 81, jun: 78, jul: 84, aug: 80, sep: 76, oct: 71, nov: 68, dec: 74 },
  { ward: 'ICU', jan: 89, feb: 93, mar: 100, apr: 97, may: 105, jun: 101, jul: 111, aug: 105, sep: 100, oct: 93, nov: 89, dec: 96 },
  { ward: 'General Ward', jan: 95, feb: 99, mar: 105, apr: 102, may: 109, jun: 106, jul: 113, aug: 108, sep: 103, oct: 96, nov: 92, dec: 98 },
  { ward: 'Obstetrics', jan: 81, feb: 85, mar: 89, apr: 87, may: 95, jun: 91, jul: 98, aug: 92, sep: 88, oct: 82, nov: 79, dec: 85 },
];

const getHeatmapColor = (value: number) => {
  if (value >= 100) return 'bg-red-200';
  if (value >= 85) return 'bg-orange-200';
  if (value >= 75) return 'bg-yellow-200';
  if (value >= 65) return 'bg-green-200';
  return 'bg-blue-200';
};

export default function OccupancyPage() {
  const avgOccupancy = 76.8;
  const totalPatientDays = monthlyOccupancyData.reduce((sum, m) => sum + m.patientDays, 0);
  const peakMonth = monthlyOccupancyData.reduce((max, m) => m.occupancy > max.occupancy ? m : max);
  const bedsAvailable = 250;
  const bedsOccupied = Math.round(bedsAvailable * (avgOccupancy / 100));

  return (
    <div className="space-y-6">
      {/* Page Header */}
      <div>
        <h1 className="text-3xl font-bold text-slate-900">Occupancy Analytics</h1>
        <p className="mt-2 text-slate-600">
          Bed occupancy rates, patient days, and ward utilization metrics
        </p>
      </div>

      {/* KPI Cards */}
      <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        <StatCard
          title="Avg Occupancy %"
          value={avgOccupancy.toFixed(1) + '%'}
          change={8.5}
          trend="up"
          color="blue"
          icon={TrendingUp}
        />
        <StatCard
          title="Total Patient Days"
          value={totalPatientDays.toLocaleString()}
          change={12}
          trend="up"
          color="green"
        />
        <StatCard
          title="Beds Available"
          value={bedsAvailable.toString()}
          subtitle={`${bedsOccupied} occupied`}
          color="amber"
        />
        <StatCard
          title="Peak Month"
          value={peakMonth.month}
          subtitle={`${peakMonth.occupancy}% occupancy`}
          color="purple"
        />
      </div>

      {/* Occupancy Trend with Benchmark */}
      <ChartCard
        title="Monthly Occupancy Trend"
        subtitle="Actual occupancy vs 75% benchmark target"
      >
        <AreaChartComponent
          data={monthlyOccupancyData}
          xKey="month"
          yKeys={[
            { key: 'occupancy', color: '#00b8a0', name: 'Actual Occupancy' },
            { key: 'benchmark', color: '#e11d48', name: 'Benchmark (75%)' },
          ]}
          height={300}
          formatY={(v) => v.toFixed(0) + '%'}
        />
      </ChartCard>

      {/* Patient Days by Ward */}
      <ChartCard
        title="Patient Days by Ward"
        subtitle="Stacked monthly view across all wards"
      >
        <BarChartComponent
          data={[
            { month: 'Jan', Cardiology: 285, Orthopedics: 245, Pediatrics: 215, ICU: 165, General: 295, Obstetrics: 195 },
            { month: 'Feb', Cardiology: 298, Orthopedics: 258, Pediatrics: 228, ICU: 172, General: 308, Obstetrics: 205 },
            { month: 'Mar', Cardiology: 312, Orthopedics: 272, Pediatrics: 238, ICU: 185, General: 325, Obstetrics: 215 },
            { month: 'Apr', Cardiology: 301, Orthopedics: 265, Pediatrics: 232, ICU: 180, General: 315, Obstetrics: 210 },
            { month: 'May', Cardiology: 325, Orthopedics: 285, Pediatrics: 248, ICU: 195, General: 338, Obstetrics: 228 },
            { month: 'Jun', Cardiology: 315, Orthopedics: 278, Pediatrics: 240, ICU: 188, General: 328, Obstetrics: 220 },
            { month: 'Jul', Cardiology: 338, Orthopedics: 295, Pediatrics: 258, ICU: 205, General: 350, Obstetrics: 235 },
            { month: 'Aug', Cardiology: 320, Orthopedics: 280, Pediatrics: 245, ICU: 195, General: 335, Obstetrics: 222 },
            { month: 'Sep', Cardiology: 305, Orthopedics: 268, Pediatrics: 235, ICU: 185, General: 320, Obstetrics: 212 },
            { month: 'Oct', Cardiology: 290, Orthopedics: 250, Pediatrics: 218, ICU: 172, General: 298, Obstetrics: 198 },
            { month: 'Nov', Cardiology: 280, Orthopedics: 242, Pediatrics: 210, ICU: 165, General: 285, Obstetrics: 190 },
            { month: 'Dec', Cardiology: 295, Orthopedics: 255, Pediatrics: 228, ICU: 178, General: 305, Obstetrics: 205 },
          ]}
          xKey="month"
          bars={[
            { key: 'Cardiology', color: '#7c3aed', name: 'Cardiology' },
            { key: 'Orthopedics', color: '#f59e0b', name: 'Orthopedics' },
            { key: 'Pediatrics', color: '#06b6d4', name: 'Pediatrics' },
            { key: 'ICU', color: '#e11d48', name: 'ICU' },
            { key: 'General', color: '#10b981', name: 'General Ward' },
            { key: 'Obstetrics', color: '#8b5cf6', name: 'Obstetrics' },
          ]}
          height={300}
        />
      </ChartCard>

      {/* YoY Occupancy Comparison */}
      <ChartCard
        title="Year-over-Year Occupancy Comparison"
        subtitle="Occupancy rates across 2024, 2025, and 2026"
      >
        <LineChartComponent
          data={yoyOccupancyData}
          xKey="month"
          lines={[
            { key: 'year2024', color: '#94a3b8', name: '2024' },
            { key: 'year2025', color: '#3b82f6', name: '2025' },
            { key: 'year2026', color: '#00b8a0', name: '2026' },
          ]}
          height={300}
          formatY={(v) => v.toFixed(0) + '%'}
        />
      </ChartCard>

      {/* Occupancy Heatmap */}
      <Card>
        <CardHeader>
          <CardTitle>Occupancy Heatmap</CardTitle>
          <CardDescription>Month x Ward occupancy percentage (color-coded)</CardDescription>
        </CardHeader>
        <CardContent>
          <div className="overflow-x-auto">
            <table className="w-full border-collapse">
              <thead>
                <tr>
                  <th className="border bg-gray-100 px-4 py-2 text-left font-semibold">Ward</th>
                  {['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'].map(m => (
                    <th key={m} className="border bg-gray-100 px-2 py-2 text-center font-semibold text-sm">{m}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {heatmapData.map(row => (
                  <tr key={row.ward}>
                    <td className="border bg-gray-50 px-4 py-2 font-medium">{row.ward}</td>
                    {[
                      row.jan, row.feb, row.mar, row.apr, row.may, row.jun,
                      row.jul, row.aug, row.sep, row.oct, row.nov, row.dec
                    ].map((val, idx) => (
                      <td key={idx} className={`border px-2 py-2 text-center text-sm font-semibold ${getHeatmapColor(val)}`}>
                        {val}%
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div className="mt-4 flex gap-4 text-sm">
            <div className="flex items-center gap-2"><div className="h-4 w-4 bg-blue-200"></div>Below 65%</div>
            <div className="flex items-center gap-2"><div className="h-4 w-4 bg-green-200"></div>65-75%</div>
            <div className="flex items-center gap-2"><div className="h-4 w-4 bg-yellow-200"></div>75-85%</div>
            <div className="flex items-center gap-2"><div className="h-4 w-4 bg-orange-200"></div>85-100%</div>
            <div className="flex items-center gap-2"><div className="h-4 w-4 bg-red-200"></div>100%+</div>
          </div>
        </CardContent>
      </Card>

      {/* Utilization Efficiency Metrics */}
      <Card>
        <CardHeader>
          <CardTitle>Utilization Efficiency Metrics</CardTitle>
          <CardDescription>Performance indicators and benchmarks</CardDescription>
        </CardHeader>
        <CardContent>
          <div className="grid gap-6 md:grid-cols-3">
            <div className="space-y-2">
              <p className="text-sm font-medium text-slate-600">Avg Patient LOS</p>
              <p className="text-2xl font-bold">4.8 days</p>
              <p className="text-xs text-green-600">+0.2 vs benchmark</p>
            </div>
            <div className="space-y-2">
              <p className="text-sm font-medium text-slate-600">Bed Turnover Rate</p>
              <p className="text-2xl font-bold">76%</p>
              <p className="text-xs text-green-600">Above target (70%)</p>
            </div>
            <div className="space-y-2">
              <p className="text-sm font-medium text-slate-600">Unused Bed Days</p>
              <p className="text-2xl font-bold">1,840</p>
              <p className="text-xs text-amber-600">23% of capacity</p>
            </div>
          </div>
        </CardContent>
      </Card>

      {/* Benchmark Comparison */}
      <Card>
        <CardHeader>
          <CardTitle>Benchmark Comparison</CardTitle>
          <CardDescription>Performance vs industry targets</CardDescription>
        </CardHeader>
        <CardContent>
          <div className="space-y-4">
            <div>
              <div className="flex justify-between mb-2">
                <span className="text-sm font-medium">Occupancy Rate</span>
                <span className="text-sm font-semibold">76.8% / 75%</span>
              </div>
              <div className="h-2 bg-gray-200 rounded-full">
                <div className="h-2 bg-green-500 rounded-full" style={{ width: '76.8%' }}></div>
              </div>
            </div>
            <div>
              <div className="flex justify-between mb-2">
                <span className="text-sm font-medium">Bed Turnover</span>
                <span className="text-sm font-semibold">76% / 70%</span>
              </div>
              <div className="h-2 bg-gray-200 rounded-full">
                <div className="h-2 bg-green-500 rounded-full" style={{ width: '76%' }}></div>
              </div>
            </div>
            <div>
              <div className="flex justify-between mb-2">
                <span className="text-sm font-medium">Avg LOS</span>
                <span className="text-sm font-semibold">4.8 / 5.2 days</span>
              </div>
              <div className="h-2 bg-gray-200 rounded-full">
                <div className="h-2 bg-blue-500 rounded-full" style={{ width: '92%' }}></div>
              </div>
            </div>
          </div>
        </CardContent>
      </Card>
    </div>
  );
