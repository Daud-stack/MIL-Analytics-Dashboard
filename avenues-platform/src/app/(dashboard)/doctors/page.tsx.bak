'use client';

import { useState, useMemo } from 'react';
import {
  BarChart,
  Bar,
  LineChart,
  Line,
  PieChart,
  Pie,
  Cell,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  Legend,
  ResponsiveContainer,
  ScatterChart,
  Scatter,
} from 'recharts';
import {
  ArrowUpDown,
  Download,
  Search,
  Users,
  TrendingUp,
  DollarSign,
  Activity,
  Stethoscope,
} from 'lucide-react';

// Sample data: 20+ doctors
const DOCTORS_DATA = [
  {
    id: 1,
    name: 'Dr. Amara Okoro',
    specialty: 'Surgery',
    episodes: 245,
    revenue: 1225000,
    avgRevenuePerEpisode: 5000,
    avgLOS: 3.2,
    uniquePatients: 180,
  },
  {
    id: 2,
    name: 'Dr. Benjamin Mensah',
    specialty: 'Medicine',
    episodes: 312,
    revenue: 936000,
    avgRevenuePerEpisode: 3000,
    avgLOS: 4.5,
    uniquePatients: 280,
  },
  {
